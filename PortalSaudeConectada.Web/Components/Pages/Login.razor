@page "/login"
@using PortalSaudeConectada.Web.Services.Auth
@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Login - Portal Saúde Conectada</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            🏥 Portal Saúde Conectada
        </MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
            Faça login para acessar o sistema
        </MudText>

        <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <MudTextField @bind-Value="_loginModel.Username"
                          Label="Usuário"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Required="true"
                          Class="mb-4"
                          Disabled="@_isLoading" />

            <MudTextField @bind-Value="_loginModel.Password"
                          Label="Senha"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          InputType="InputType.Password"
                          Required="true"
                          Class="mb-4"
                          Disabled="@_isLoading" />

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @_errorMessage
                </MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       Disabled="@_isLoading">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Entrando...</span>
                }
                else
                {
                    <span>Entrar</span>
                }
            </MudButton>
        </EditForm>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
            Usuários de teste:<br />
            <strong>admin</strong> / Admin@123<br />
            <strong>gestor</strong> / Gestor@123<br />
            <strong>profissional</strong> / Prof@123
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private LoginModel _loginModel = new();
    private bool _isLoading = false;
    private string? _errorMessage;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task HandleLogin()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(_loginModel.Username, _loginModel.Password);

            if (result != null)
            {
                // Notificar mudança no estado de autenticação
                if (AuthStateProvider is CustomAuthenticationStateProvider customProvider)
                {
                    customProvider.NotifyAuthenticationStateChanged();
                }

                // Redirecionar para a página solicitada ou home
                Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);
            }
            else
            {
                _errorMessage = "Usuário ou senha inválidos";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = "Erro ao fazer login. Tente novamente.";
            Console.WriteLine($"Erro no login: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}

